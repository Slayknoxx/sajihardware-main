# SAJI Hardware POS environment template.
# Copy to .env and fill in what you need. Never commit .env.

# --- Licensing ---------------------------------------------------------------
# The public key ships with the app. The private key stays in tools/keys and
# must never be copied to a customer machine.
# LICENSE_PUBLIC_KEY=
# LICENSE_TRIAL_DAYS=14
# LICENSE_GRACE_DAYS=7
# Optional hybrid check-in server. Leave blank for fully offline operation.
# LICENSE_SERVER_URL=
# LICENSE_CHECKIN_HOURS=24

# --- KRA eTIMS / VSCU --------------------------------------------------------
# ETIMS_ENABLED=true
# KRA_PIN=
# VSCU_SERIAL=
# VSCU_VERIFICATION_KEY=
# VSCU_DEVICE_ID=
# ETIMS_SANDBOX=true
# ETIMS_BASE_URL=

# --- KCB Buni M-Pesa ---------------------------------------------------------
# See api/config.php for the full list. Keep these out of the public folder.
# KCB_BUNI_ENABLED=true
# KCB_CONSUMER_KEY=
# KCB_CONSUMER_SECRET=
# KCB_ORG_SHORT_CODE=
# KCB_ORG_PASSKEY=
# KCB_CALLBACK_URL=https://your-domain.example/api/callback.php
# KCB_CALLBACK_TOKEN=change-me-to-a-long-random-value
# PAYMENT_DB_HOST=127.0.0.1
# PAYMENT_DB_NAME=saji_payments
# PAYMENT_DB_USER=
# PAYMENT_DB_PASS=
