# ============================================================
# KCB BUNI STK PUSH - ENVIRONMENT CONFIG
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to git or share it publicly.
# ============================================================

# --- KCB Buni credentials (from sandbox.buni.kcbgroup.com) ---
KCB_CONSUMER_KEY=your_consumer_key_here
KCB_CONSUMER_SECRET=your_consumer_secret_here

# Base URL: use the UAT (sandbox) URL while testing.
# Sandbox: https://uat.buni.kcbgroup.com
# Production (after go-live approval): https://api.buni.kcbgroup.com
KCB_BASE_URL=https://uat.buni.kcbgroup.com

# Your Paybill/Till (org short code) given by KCB. In sandbox you can
# usually use the shared test short code provided in the developer portal.
KCB_ORG_SHORT_CODE=522522

# Usually left blank for STK Push (only needed for some products)
KCB_ORG_PASSKEY=

# true if you are using KCB's shared shortcode (most sandbox/starter setups)
KCB_SHARED_SHORTCODE=true

# --- Callback security ---
# A long random secret YOU make up. It gets appended to your callback URL
# as a path segment so random internet traffic can't fake a callback.
# Generate one with: php -r "echo bin2hex(random_bytes(24));"
CALLBACK_SECRET=change_this_to_a_long_random_string

# Full public callback URL that KCB will call after the transaction.
# While testing this MUST be your ngrok https URL, e.g.:
# https://abcd1234.ngrok-free.app/api/callback.php/change_this_to_a_long_random_string
CALLBACK_URL=https://your-ngrok-subdomain.ngrok-free.app/api/callback.php/change_this_to_a_long_random_string

# --- App security ---
# Random string used to sign/validate simple app-level requests (CSRF-ish token)
APP_SECRET=change_this_too_to_another_long_random_string

# Optional: comma separated list of allowed origins for CORS (leave blank to allow same-origin only)
ALLOWED_ORIGIN=
